
{
    "scopeName": "source.hurtip",
    "patterns": [
        {
            "name": "keyword.control.hurtip",
            "match": "\\bcreate\\b"
        },
        {
            "name": "entity.name.function.hurtip",
            "match": "\\bview(?=\\s*\\()"
        },
        {
            "name": "string.quoted.double.hurtip",
            "begin": "\"",
            "end": "\""
        },
        {
            "name": "constant.numeric.hurtip",
            "match": "\\b[0-9]+\\b"
        },
        {
            "name": "keyword.operator.assignment.hurtip",
            "match": "="
        }
    ]
}
