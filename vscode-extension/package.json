
{
    "name": "hurtip-language",
    "displayName": "Hurtip Language Support",
    "description": "Language support for the Hurtip programming language",
    "version": "0.1.0",
    "publisher": "hurtip",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "hurtip",
                "aliases": [
                    "Hurtip",
                    "hurtip"
                ],
                "extensions": [
                    ".hurtip"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "hurtip",
                "scopeName": "source.hurtip",
                "path": "./syntaxes/hurtip.tmLanguage.json"
            }
        ],
        "iconThemes": [
            {
                "id": "seti-hurtip",
                "label": "Seti + Hurtip",
                "path": "./icons/seti/vs-seti-icon-theme.json"
            }
        ]
    }
}
