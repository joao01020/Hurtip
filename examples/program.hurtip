
// Meu primeiro programa em Hurtip

// Variáveis
create language = "Hurtip"
create version = 1
create age = 24
create is_active = true
create is_finished = false

// Exibindo valores
view(language)
view(version)
view(age)
view(is_active)
view(is_finished)

// Operações matemáticas
create sum = 10 + 5
create subtraction = 10 - 5
create multiplication = 10 * 5
create division = 10 / 5

view(sum)
view(subtraction)
view(multiplication)
view(division)

// Precedência matemática
create result = 10 + 5 * 2
create grouped_result = (10 + 5) * 2

view(result)
view(grouped_result)

// Operadores unários
create negative = -10
create positive = +10

view(negative)
view(positive)

// Comparações
view(age == 24)
view(age != 18)
view(age > 18)
view(age < 30)
view(age >= 24)
view(age <= 24)

// Operadores lógicos
view(true and true)
view(true and false)
view(false or true)
view(false or false)
view(not true)
view(not false)

// Combinando operadores
view(age >= 18 and age <= 30)
view(age < 18 or age == 24)
view(not age > 18)

// Precedência lógica
view(true or false and false)
view((true or false) and false)
view(not false and true)

// Curto-circuito
view(false and missing == 1)
view(true or missing == 1)

// Comentários
create comment_test = 100 // Comentário na mesma linha

view(comment_test)

// Condicionais
if (age >= 18) {
    view("Maior de idade")
}

if (age < 18) {
    view("Menor de idade")
} else {
    view("Maior de idade")
}

// Condições lógicas
create has_permission = true

if (age >= 18 and has_permission) {
    view("Acesso permitido")
} else {
    view("Acesso negado")
}

// Usando not
if (not false) {
    view("A condição é verdadeira")
} else {
    view("A condição é falsa")
}

// Condicionais aninhadas
if (age >= 18) {
    if (age >= 21) {
        view("Idade igual ou superior a 21")
    } else {
        view("Idade entre 18 e 20")
    }
} else {
    view("Menor de idade")
}

// If sem else
create number = 10

if (number == 10) {
    view("O número é 10")
}

// Else em outra linha
if (age == 18) {
    view("Tem 18 anos")
}
else {
    view("Não tem 18 anos")
}

// Atribuição
create counter = 0

view(counter)

counter = counter + 1
view(counter)

counter = counter + 1
view(counter)

// Alterando texto
create message = "Hello"
message = "Hello Hurtip"

view(message)

// Alterando booleanos
create is_ready = false
is_ready = true

view(is_ready)

// Atribuição dentro de if
if (counter == 2) {
    counter = 10
}

view(counter)

// While
create while_counter = 1

while (while_counter <= 5) {
    view(while_counter)
    while_counter = while_counter + 1
}

view("Loop finished")

// Break
create break_counter = 0

while (break_counter < 10) {
    break_counter = break_counter + 1

    if (break_counter == 5) {
        break
    }

    view(break_counter)
}

view("Break finished")

// Continue
create continue_counter = 0

while (continue_counter < 5) {
    continue_counter = continue_counter + 1

    if (continue_counter == 3) {
        continue
    }

    view(continue_counter)
}

view("Continue finished")

// Break e continue
create control_counter = 0

while (control_counter < 10) {
    control_counter = control_counter + 1

    if (control_counter == 3) {
        continue
    }

    if (control_counter == 7) {
        break
    }

    view(control_counter)
}

view("Control flow finished")

// Loops aninhados
create outer = 0

while (outer < 3) {
    outer = outer + 1

    create inner = 0

    while (inner < 5) {
        inner = inner + 1

        if (inner == 3) {
            break
        }

        view(inner)
    }

    view(outer)
}

view("Nested loops finished")

// Arrays
create numbers = [10, 20, 30, 40, 50]
create names = ["Ana", "João", "Maria"]
create active_states = [true, false, true]

// Array vazio
create empty_array = []

// Exibindo arrays
view(numbers)
view(names)
view(active_states)
view(empty_array)

// Acessando elementos
view(numbers[0])
view(numbers[1])
view(numbers[2])

view(names[0])
view(names[1])
view(names[2])

view(active_states[0])
view(active_states[1])

// Tipos diferentes
create mixed_array = [10, "Hurtip", true]

view(mixed_array)

// Acessando elementos mistos
view(mixed_array[0])
view(mixed_array[1])
view(mixed_array[2])

// Arrays aninhados
create matrix = [
    [1, 2],
    [3, 4],
    [5, 6]
]

view(matrix)

// Acessando arrays internos
view(matrix[0])
view(matrix[1])
view(matrix[2])

// Acessando elementos internos
view(matrix[0][0])
view(matrix[0][1])
view(matrix[1][0])
view(matrix[1][1])
view(matrix[2][0])
view(matrix[2][1])

// Modificando arrays
numbers[0] = 100
numbers[1] = 200
numbers[2] = 300

view(numbers)

// Modificando outros tipos
names[0] = "Carlos"
active_states[1] = true

view(names)
view(active_states)

// Modificando array misto
mixed_array[0] = 99
mixed_array[1] = "Programming"
mixed_array[2] = false

view(mixed_array)

// Modificando arrays aninhados
matrix[0][0] = 10
matrix[1][1] = 40
matrix[2][0] = 50

view(matrix)

// Verificando alterações
view(matrix[0][0])
view(matrix[1][1])
view(matrix[2][0])

// Tamanho dos arrays: length
create length_numbers = [10, 20, 30]
create length_empty = []
create length_matrix = [[1, 2], [3, 4]]

view(length_numbers.length)
view(length_empty.length)
view(length_matrix.length)
view(length_matrix[0].length)

// Adicionando elementos: push()
create push_numbers = [10, 20]

push_numbers.push(30)

view(push_numbers)
view(push_numbers.length)

// Arrays com tipos diferentes
create push_mixed = ["Hurtip", 10, true]

push_mixed.push("C++")

view(push_mixed)

// Removendo o último elemento: pop()
create pop_numbers = [10, 20, 30]

create last_element = pop_numbers.pop()

view(last_element)
view(pop_numbers)
view(pop_numbers.length)

// Removendo elementos por índice: remove()
create remove_numbers = [10, 20, 30, 40]

create removed_element = remove_numbers.remove(1)

view(removed_element)
view(remove_numbers)
view(remove_numbers.length)

// Inserindo elementos por índice: insert()
create insert_numbers = [10, 30, 40]

insert_numbers.insert(1, 20)

view(insert_numbers)

// Inserindo no início
insert_numbers.insert(0, 5)

view(insert_numbers)

// Inserindo no final
insert_numbers.insert(insert_numbers.length, 50)

view(insert_numbers)

// Inserindo em um array vazio
create insert_empty = []

insert_empty.insert(0, "Hurtip")

view(insert_empty)

// Inserindo diferentes tipos
create insert_mixed = [10, true]

insert_mixed.insert(1, "Hello")

view(insert_mixed)

// Fim dos arrays
view("Arrays finished")

// Fim do programa
view("Hello Hurtip!")
